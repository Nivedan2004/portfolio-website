# Public agent only. Enable only after reviewing the agent, retention, and origins.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_VOICE_ENABLED=false
# Describe verified provider recording/retention before enabling voice.
NEXT_PUBLIC_VOICE_PRIVACY_NOTICE=
# Native dark calendar. All values below are SERVER-ONLY.
# Follow docs/CALENDAR_SETUP.md; the public Google booking link is not API authorization.
BOOKING_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Saved by npm run calendar:connect after owner consent:
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
BOOKING_TIMEZONE=America/Los_Angeles
BOOKING_DURATION_MINUTES=60
BOOKING_NOTICE_HOURS=2
BOOKING_HORIZON_DAYS=60
BOOKING_BUFFER_MINUTES=0
# Optional JSON override; empty uses owner-confirmed hours in lib/booking-settings.ts.
BOOKING_WEEKLY_HOURS=
BOOKING_REDIS_REST_URL=
BOOKING_REDIS_REST_TOKEN=
# Set to the exact public origin on deployment; local dev derives it from the request.
BOOKING_SITE_ORIGIN=
